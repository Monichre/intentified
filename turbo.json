{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },

    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  },
  "globalEnv": [
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY",
    "CLERK_PUBLIC_KEY",
    
    

    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    
    

    "DATABASE_URL",
    "DIRECT_URL",
    "SUPABASE_PROJECT_ID",
    "SUPABASE_SERVICE_ROLE_API_KEY",
    "NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_API_KEY",
    "GOOGLE_API_KEY",
    "STRIPE_ACCOUNT_ID",
    "BASEHUB_TOKEN",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",

    "PRODUCT_BOARD_API_KEY",

    "GOOGLE_CLOUD_CRUX_KEY",

    

    "SUPABASE_SERVICE_ROLE_KEY",

    "KV_URL",
    "UPSTASH_REDIS_URL",
    "UPSTASH_REDIS_TOKEN",
    "KV_REST_API_READ_ONLY_TOKEN",
    "REDIS_URL",

    "UPSTASH_VECTOR_REST_TOKEN",
    "UPSTASH_VECTOR_REST_READONLY_TOKEN",
    "UPSTASH_VECTOR_REST_URL",

    "EXA_API_KEY",
    "CAPTURE_API_KEY",
    "CAPTURE_API_SECRET",

    "ANTHROPIC_API_KEY",
    "XAI_API_KEY",
    "FIRECRAWL_API_KEY",
    "V0_API_KEY",
    "DIFY_API_KEY",
    "OPENAI_API_KEY"
  ]
}