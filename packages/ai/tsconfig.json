{
  "extends": "../typescript-config/nextjs.json",
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "skipLibCheck": true,
    "paths": {
      "@/agents/*": ["./agents/*"],
      "@/services/*": ["./services/*"],
      "@/provider/*": ["./provider/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/**/*.ts", "services", "agents/**/*.ts", "provider/**/*.ts", "domains/enrichment"],
  "references": [
    // { "path": "@db" },
    // { "path": "../design-system" }
  ]
}