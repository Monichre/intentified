    {
      "parameters": {
        "jsCode": "// Analyze email engagement based on Gmail API response\nconst messageData = $json;\nconst snippet = messageData.snippet || '';\nconst isRead = messageData.labelIds ? !messageData.labelIds.includes('UNREAD') : false;\n\n// Simple engagement scoring\nlet engagementScore = 0;\nif (isRead) engagementScore += 30;\nif (snippet.length > 50) engagementScore += 20; // Longer snippet might indicate interaction\n\n// Check if there are replies by looking at thread messages\nconst hasReply = messageData.threadId ? false : false; // This would need thread analysis\n\nconst engagementLevel = engagementScore >= 40 ? 'high' : engagementScore >= 20 ? 'medium' : 'low';\n\nreturn [{\n  json: {\n    ...($input.item.json),\n    engagementScore,\n    engagementLevel,\n    isRead,\n    hasReply,\n    analyzedAt: new Date().toISOString()\n  }\n}];"
