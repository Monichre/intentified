      "parameters": {
        "jsCode": "// Get subject lines array and randomly select one for A/B testing\nconst subjectLines = $json.subject_lines;\nconst randomIndex = Math.floor(Math.random() * subjectLines.length);\nconst selectedSubjectLine = subjectLines[randomIndex];\n\n// Track which subject line was used for later analysis\nreturn [{\n  json: {\n    ...($input.item.json),\n    selected_subject_line: selectedSubjectLine,\n    subject_line_variant: randomIndex + 1,\n    all_subject_lines: subjectLines\n  }\n}];"
      },
