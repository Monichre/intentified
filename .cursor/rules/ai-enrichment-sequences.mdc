## Data Models

### `CompetitorAnalysisRequest`

```typescript
interface CompetitorAnalysisRequest {
  websiteUrl: string;
  companyName?: string;
  industry?: string;
  focusAreas?: ('market-position' | 'strengths' | 'opportunities')[];
  skipScreenshot?: boolean;
}
```

### `CompetitorAnalysisProgress`

```typescript
interface CompetitorAnalysisProgress {
  requestId: string;
  currentStep: number;
  totalSteps: number;
  currentType?: string;
  message: string;
  isComplete: boolean;
}
```

### `CompetitorAnalysisResponse`

```typescript
interface CompetitorAnalysisResponse {
  websiteUrl: string;
  requestId: string;
  company: {
    name: string;
    summary: string;
    positioning: string;
    screenshot?: string;
  };
  competitiveLandscape: {
    directCompetitors: Array<{
      name: string;
      url: string;
      description: string;
      strengths: string[];
    }>;
    marketPosition: {
      rank: string;
      marketShare?: string;
      growthTrend?: string;
    };
    strengths: string[];
    opportunities: string[];
  };
  insights: {
    differentiators: string[];
    recommendations: string[];
    keyTakeaways: string[];
  };
  summary: {
    totalAnalyzed: number;
    successful: number;
    failed: number;
    totalDuration: number;
  };
}
```

